# Build settings shared by every build (local export, Vercel, EAS). Nothing secret belongs here:
# keys go in .env.local, which git ignores.

# Production bundles keep only the code that is used. Without it the whole icon library (1,500+ icons)
# shipped to every visitor: tree shaking cut the web's first-load JavaScript from 5.4 MB to 2.9 MB.
# Expo still calls it experimental; checked on the web export (home, discover, movie, settings).
EXPO_UNSTABLE_TREE_SHAKING=1
EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1
