# Copy to .env.local and fill in. Get the "API Read Access Token" at https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_TOKEN=

# Supabase project URL and publishable key (Project Settings → API). Safe for the app; never put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# The web app's public address, e.g. https://your-app.vercel.app. Shared profile links from the phone apps point here.
EXPO_PUBLIC_SITE_URL=
